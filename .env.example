# Copy this file to .env and fill the values on your machine.
# .env is gitignored. The local connectors load this file.
# python scripts/mcpctl.py doctor checks the names and does not print the values.

# GitHub connector.
GITHUB_PERSONAL_ACCESS_TOKEN=

# Jira connector. JIRA_WRITE_ENABLED must be true before a confirmed create is sent.
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_WRITE_ENABLED=

# Confluence connector. This server does not publish pages.
CONFLUENCE_BASE_URL=
CONFLUENCE_EMAIL=
CONFLUENCE_API_TOKEN=

# Figma connector.
FIGMA_ACCESS_TOKEN=

# SonarQube connector. The token is optional.
# SONARQUBE_URL defaults to https://sonarcloud.io.
SONARQUBE_TOKEN=
SONARQUBE_URL=
SONARQUBE_ORG=

# Context7. Optional. Raises rate limits when set. Not started by mcpctl.
CONTEXT7_API_KEY=

# PostHog. Optional when the host uses OAuth. Not started by mcpctl.
POSTHOG_PERSONAL_API_KEY=

# AWS profile and region for the documented Aurora and EKS entries. These are not tokens.
AWS_PROFILE=
AWS_REGION=
